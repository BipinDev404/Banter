rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Message validation helper
    function isValidMessage(data) {
      return data.keys().hasAll(['userId', 'userName', 'message', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'userName', 'message', 'createdAt', 'attachment', 'reactions', 'replyTo', 'avatarId']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 20 &&
        data.message is string && data.message.size() <= 2000 &&
        (!data.keys().hasAny(['attachment']) || (
          data.attachment.keys().hasAll(['id', 'type', 'url', 'name']) &&
          data.attachment.type is string &&
          data.attachment.url is string && data.attachment.url.size() <= 900000 &&
          data.attachment.name is string && data.attachment.name.size() <= 200
        )) &&
        (!data.keys().hasAny(['reactions']) || data.reactions is list) &&
        (!data.keys().hasAny(['replyTo']) || (
          data.replyTo.keys().hasAll(['userName', 'snippet']) &&
          data.replyTo.userName is string &&
          data.replyTo.snippet is string
        )) &&
        (!data.keys().hasAny(['avatarId']) || data.avatarId is string);
    }

    // Presence validation helper
    function isValidPresence(data) {
      return data.keys().hasAll(['sessionId', 'userName', 'connectedAt', 'lastSeen']) &&
        data.keys().hasOnly(['sessionId', 'userName', 'connectedAt', 'lastSeen', 'lastReadAt', 'avatarId']) &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 20 &&
        data.connectedAt is timestamp &&
        data.lastSeen == request.time &&
        (!data.keys().hasAny(['lastReadAt']) || data.lastReadAt is timestamp) &&
        (!data.keys().hasAny(['avatarId']) || data.avatarId is string);
    }

    // Typing validation helper
    function isValidTyping(data) {
      return data.keys().hasAll(['sessionId', 'userName', 'isTyping', 'lastTyped']) &&
        data.keys().hasOnly(['sessionId', 'userName', 'isTyping', 'lastTyped']) &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 20 &&
        data.isTyping is bool &&
        data.lastTyped == request.time;
    }

    // Collection: messages (with ephemeral auto-cleanup deletion allowed)
    match /messages/{messageId} {
      allow list: if true;
      allow get: if isValidId(messageId);
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow update: if isValidId(messageId) && isValidMessage(incoming());
      allow delete: if isValidId(messageId);
    }

    // Collection: presence
    match /presence/{sessionId} {
      allow list: if true;
      allow get: if isValidId(sessionId);
      allow create, update: if isValidId(sessionId) && 
                            isValidPresence(incoming()) && 
                            incoming().sessionId == sessionId;
      allow delete: if isValidId(sessionId);
    }

    // Collection: typing
    match /typing/{sessionId} {
      allow list: if true;
      allow get: if isValidId(sessionId);
      allow create, update: if isValidId(sessionId) && 
                            isValidTyping(incoming()) && 
                            incoming().sessionId == sessionId;
      allow delete: if isValidId(sessionId);
    }

    // Collection: private_requests
    match /private_requests/{requestId} {
      allow list: if true;
      allow get: if isValidId(requestId);
      allow create, update: if isValidId(requestId);
      allow delete: if isValidId(requestId);
    }

    // Collection: private_messages
    match /private_messages/{messageId} {
      allow list: if true;
      allow get: if isValidId(messageId);
      allow create, update: if isValidId(messageId);
      allow delete: if isValidId(messageId);
    }

    // Collection: friend_requests
    match /friend_requests/{requestId} {
      allow list: if true;
      allow get: if isValidId(requestId);
      allow create, update: if isValidId(requestId);
      allow delete: if isValidId(requestId);
    }

    // Collection: friendships
    match /friendships/{friendshipId} {
      allow list: if true;
      allow get: if isValidId(friendshipId);
      allow create, update: if isValidId(friendshipId);
      allow delete: if isValidId(friendshipId);
    }

    // Collection: user_status
    match /user_status/{sessionId} {
      allow list: if true;
      allow get: if isValidId(sessionId);
      allow create, update: if isValidId(sessionId);
      allow delete: if isValidId(sessionId);
    }

    // Collection: groups (friend groups)
    match /groups/{groupId} {
      allow list: if true;
      allow get: if isValidId(groupId);
      allow create, update: if isValidId(groupId);
      allow delete: if isValidId(groupId);
    }

    // Collection: group_messages
    match /group_messages/{messageId} {
      allow list: if true;
      allow get: if isValidId(messageId);
      allow create, update: if isValidId(messageId);
      allow delete: if isValidId(messageId);
    }
  }
}
