rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Message validation helper
    function isValidMessage(data) {
      return data.keys().hasAll(['userId', 'userName', 'message', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'userName', 'message', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 20 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        data.createdAt == request.time;
    }

    // Presence validation helper
    function isValidPresence(data) {
      return data.keys().hasAll(['sessionId', 'userName', 'connectedAt', 'lastSeen']) &&
        data.keys().hasOnly(['sessionId', 'userName', 'connectedAt', 'lastSeen']) &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 20 &&
        data.connectedAt is timestamp &&
        data.lastSeen == request.time;
    }

    // Typing validation helper
    function isValidTyping(data) {
      return data.keys().hasAll(['sessionId', 'userName', 'isTyping', 'lastTyped']) &&
        data.keys().hasOnly(['sessionId', 'userName', 'isTyping', 'lastTyped']) &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 20 &&
        data.isTyping is bool &&
        data.lastTyped == request.time;
    }

    // Collection: messages
    match /messages/{messageId} {
      allow list: if true;
      allow get: if isValidId(messageId);
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow update, delete: if false;
    }

    // Collection: presence
    match /presence/{sessionId} {
      allow list: if true;
      allow get: if isValidId(sessionId);
      allow create, update: if isValidId(sessionId) && 
                            isValidPresence(incoming()) && 
                            incoming().sessionId == sessionId;
      allow delete: if isValidId(sessionId);
    }

    // Collection: typing
    match /typing/{sessionId} {
      allow list: if true;
      allow get: if isValidId(sessionId);
      allow create, update: if isValidId(sessionId) && 
                            isValidTyping(incoming()) && 
                            incoming().sessionId == sessionId;
      allow delete: if isValidId(sessionId);
    }
  }
}
