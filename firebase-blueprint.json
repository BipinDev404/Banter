{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A chat message in the global room",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique client session or user ID",
          "maxLength": 128,
          "minLength": 1
        },
        "userName": {
          "type": "string",
          "description": "Display name of the sender",
          "maxLength": 20,
          "minLength": 1
        },
        "message": {
          "type": "string",
          "description": "Content of the chat message",
          "maxLength": 500,
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["userId", "userName", "message", "createdAt"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Active session presence record for online counter",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique session ID of connected user",
          "maxLength": 128,
          "minLength": 1
        },
        "userName": {
          "type": "string",
          "description": "Display name of connected user",
          "maxLength": 20,
          "minLength": 1
        },
        "connectedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when session connected"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last heartbeat"
        }
      },
      "required": ["sessionId", "userName", "connectedAt", "lastSeen"]
    },
    "TypingStatus": {
      "title": "TypingStatus",
      "description": "Real-time typing status of connected users",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique session ID of user",
          "maxLength": 128,
          "minLength": 1
        },
        "userName": {
          "type": "string",
          "description": "Display name of typing user",
          "maxLength": 20,
          "minLength": 1
        },
        "isTyping": {
          "type": "boolean",
          "description": "Whether the user is currently inputting text"
        },
        "lastTyped": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of typing event"
        }
      },
      "required": ["sessionId", "userName", "isTyping", "lastTyped"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request sent from one user to another",
      "type": "object",
      "properties": {
        "fromSessionId": { "type": "string", "maxLength": 128 },
        "fromUserName": { "type": "string", "maxLength": 20 },
        "toSessionId": { "type": "string", "maxLength": 128 },
        "toUserName": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] }
      },
      "required": ["fromSessionId", "fromUserName", "toSessionId", "toUserName", "status"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Confirmed friendship between two users",
      "type": "object",
      "properties": {
        "friendshipId": { "type": "string", "maxLength": 128 },
        "participants": { "type": "array" }
      },
      "required": ["friendshipId", "participants"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Global chat messages collection"
    },
    "/presence/{sessionId}": {
      "schema": "Presence",
      "description": "Active presence sessions for online count"
    },
    "/typing/{sessionId}": {
      "schema": "TypingStatus",
      "description": "Active typing indicators for real-time chat"
    },
    "/friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Pending and processed friend requests"
    },
    "/friendships/{friendshipId}": {
      "schema": "Friendship",
      "description": "Confirmed mutual friendships"
    }
  }
}
